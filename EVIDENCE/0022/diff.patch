+/** Rake pitch is required. Hip and valley pitch may stay plan-only. */
+export function roofLineRequiresPitch(type: RoofLineMeasurementType): boolean {
+  return roofLineTypeMeta(type).pitchAdjustment === "required";
+}
+
+export function roofLineIsComplete(line: RoofLineMeasurement): boolean {
+  if (!roofLineRequiresPitch(line.type)) return true;
+  return line.pitchRiseOver12 !== undefined;
+}
+
+/** Incomplete required-pitch lines stay out of calculator totals. */
+export function roofLineCountableFeet(line: RoofLineMeasurement): number {
+  if (!roofLineIsComplete(line)) return 0;
+  return roofLineAdjustedFeet(line);
+}
+
 export function roofLineUsesPitch(type: RoofLineMeasurementType): boolean {
   return roofLineTypeMeta(type).pitchAdjustment !== "none";
 }
